ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Get these from console.groq.com and aistudio.google.com — never commit real values.
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# Optional: override the default models without editing code. Free-tier model
# names change often — if you get a 404 "model not found", pick a current one
# from console.groq.com/docs/models or ai.google.dev/gemini-api/docs/models.
# GROQ_MODEL=
# GEMINI_MODEL=